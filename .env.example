# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Database SQLite file path
DB_PATH=habit_tracker.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Telegram Mini App / HTML Widget settings
# Public HTTPS URL, e.g. from cloudflared tunnel or ngrok (e.g. https://your-domain.trycloudflare.com)
WIDGET_BASE_URL=
# Embedded HTTP server host and port
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Max age for initData timestamp in seconds (default: 86400 = 24 hours)
WEBAPP_AUTH_MAX_AGE=86400
